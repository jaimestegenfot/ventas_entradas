# Desarrollo local: Node.js 22.13 o posterior dentro de la rama 22.x.
# Sin Turso ni Blob se usan SQLite e imágenes dentro de .data/.
COOKIE_SECURE=false

# Opcional en local; obligatorio en Vercel. Solo se usa al crear el administrador.
# ADMIN_PASSWORD=elige-una-clave-larga-y-unica

# Vercel: base libSQL remota de Turso, con token de lectura y escritura.
# TURSO_DATABASE_URL=libsql://nombre-organizacion.turso.io
# TURSO_AUTH_TOKEN=

# Vercel: conectar un almacén Blob de acceso público al proyecto.
# BLOB_READ_WRITE_TOKEN=

# Opcionales, solo para instalaciones locales con disco persistente.
# ENTRADA_DATA_DIR=C:/ruta/datos
# ENTRADA_DB_PATH=C:/ruta/datos/entrada.sqlite

# SUPABASE_URL y SUPABASE_SECRET_KEY pertenecen al prototipo anterior.
# La aplicación actual no los utiliza.
