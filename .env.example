# Opcional. Se usa únicamente al inicializar una base de datos nueva.
# Si no se define, se genera una contraseña en .data/admin-access.txt.
# ADMIN_PASSWORD=elige-una-clave-larga-y-unica

# Activa cookies Secure exclusivamente al servir con HTTPS.
COOKIE_SECURE=false

# Opcional: ruta de un archivo SQLite en un disco persistente.
# ENTRADA_DB_PATH=C:/ruta/entrada.sqlite

# Las variables Supabase del prototipo anterior no se utilizan en esta versión.
